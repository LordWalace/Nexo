if [ -d "backend/.venv" ]; then
    export VIRTUAL_ENV="$(pwd)/backend/.venv"
    if [ "$OS" = "Windows_NT" ]; then
        export PATH="$VIRTUAL_ENV/Scripts:$PATH"
    else
        export PATH="$VIRTUAL_ENV/bin:$PATH"
    fi
    echo "✅ Ambiente virtual Python ativo (.venv em backend/)"
else
    echo "⚠️ Ambiente virtual (.venv) não encontrado em backend/."
    echo "💡 Execute o script setup-dev do seu sistema operacional para configurar."
fi
